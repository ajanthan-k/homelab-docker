{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':automergeMinor',
    ':automergeBranch',
    ':disableDigestUpdates',
    ':timezone(Europe/London)',
  ],
  schedule: ['* 23,0-6 * * *'],
  ignoreTests: true,
  packageRules: [
    {
      description: 'Databases and sidecars: update manually',
      matchPackageNames: [
        '/redis/',
        '/postgres/',
        '/postgis/',
        '/pgvecto-rs/',
        '/meilisearch/',
        '/alpine-chrome/',
        '/gotenberg/',
        '/tika/',
      ],
      enabled: false,
    },
    {
      description: 'hotio tags: release-X.Y[.Z[.B]] (nightly- for Sonarr v5 beta; compatibility keeps each image on its channel)',
      matchPackageNames: ['ghcr.io/hotio/**'],
      versioning: 'regex:^(?<compatibility>release|nightly)-(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?(\\.(?<build>\\d+))?$',
    },
    { matchPackageNames: ['ghcr.io/hotio/bazarr'], sourceUrl: 'https://github.com/morpheus65535/bazarr' },
    { matchPackageNames: ['ghcr.io/hotio/jellyfin'], sourceUrl: 'https://github.com/jellyfin/jellyfin' },
    { matchPackageNames: ['ghcr.io/hotio/prowlarr'], sourceUrl: 'https://github.com/Prowlarr/Prowlarr' },
    { matchPackageNames: ['ghcr.io/hotio/qbittorrent'], sourceUrl: 'https://github.com/qbittorrent/qBittorrent' },
    { matchPackageNames: ['ghcr.io/hotio/radarr'], sourceUrl: 'https://github.com/Radarr/Radarr' },
    { matchPackageNames: ['ghcr.io/hotio/sonarr'], sourceUrl: 'https://github.com/Sonarr/Sonarr' },
    {
      description: 'Never automerge: Jellyfin (DB migrations), Sonarr (on beta)',
      matchPackageNames: ['ghcr.io/hotio/jellyfin', 'ghcr.io/hotio/sonarr'],
      automerge: false,
    },
    {
      description: 'Review minor updates manually (breaking changes ship in minors)',
      matchPackageNames: ['ghcr.io/home-assistant/home-assistant', 'ghcr.io/immich-app/**'],
      matchUpdateTypes: ['minor'],
      automerge: false,
    },
  ],
}
